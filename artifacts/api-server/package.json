{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development pnpm run build:dev",
    "build:dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --env-file=../../.env --enable-source-maps ./dist/index.mjs",
    "test": "cross-env LOG_LEVEL=silent vitest run",
    "test:watch": "cross-env LOG_LEVEL=silent vitest",
    "test:ci": "pnpm --filter @workspace/scripts run seed && cross-env LOG_LEVEL=silent vitest run"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/billing": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/pg-client-db": "workspace:*",
    "canvas": "^3.2.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "jsqr": "^1.4.0",
    "multer": "^2.2.0",
    "node-forge": "^1.4.0",
    "pdfjs-dist": "^6.2.108",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/node-forge": "^1.3.14",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.9"
  }
}
